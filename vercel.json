{
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/factory/claude.js": {
      "maxDuration": 300
    },
    "api/pay/file.js": {
      "includeFiles": "{books.js,exam/data.json,paid/**}"
    },
    "api/pay/quote.js": {
      "includeFiles": "{books.js,exam/data.json}"
    },
    "api/pay/confirm.js": {
      "includeFiles": "{books.js,exam/data.json}"
    },
    "api/pay/order.js": {
      "includeFiles": "{books.js,exam/data.json}"
    },
    "api/admin.js": {
      "includeFiles": "{books.js,exam/data.json}"
    }
  },
  "headers": [
    {
      "source": "/admin(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/factory(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/paid/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/pay/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/a.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ]
}