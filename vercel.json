{
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": { "api/factory/claude.js": { "maxDuration": 300 } },
  "headers": [
    { "source": "/factory(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/api/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] }
  ]
}
